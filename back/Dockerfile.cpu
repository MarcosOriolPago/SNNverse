# Stage 1: Builder image
FROM python:3.11-slim as builder

ARG GENN_VER=latest
LABEL maintainer="SpikeVerse Team"

# Non-interactive timezone configuration
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# Set environment variables
ENV GENN_PATH=/opt/genn
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get install -yq --no-install-recommends \
    build-essential \
    cmake \
    git \
    swig \
    pkg-config \
    libffi-dev \
    curl \
    wget \
    ninja-build \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Ensure we install requirements BEFORE building GeNN to sync the NumPy C-API version
WORKDIR /build
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir numpy psutil pybind11 pkgconfig

# Clone and build GeNN
RUN mkdir -p ${GENN_PATH} && \
    git clone https://github.com/genn-team/genn.git ${GENN_PATH}

WORKDIR ${GENN_PATH}

# Build GeNN with CPU-only support (no CUDA)
RUN python setup.py develop

# Stage 2: Runtime image
FROM python:3.11-slim

# Non-interactive timezone configuration
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# Set environment variables
ENV GENN_PATH=/opt/genn
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV APP_DIR=/app

WORKDIR ${APP_DIR}

# Install runtime C++ dependencies needed by GeNN's JIT compilation
RUN apt-get update && \
    apt-get upgrade -y && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get install -yq --no-install-recommends \
    build-essential \
    cmake \
    git \
    libffi-dev \
    libssl3 \
    libstdc++6 \
    libgcc-s1 \
    zlib1g \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --upgrade pip setuptools wheel

# Copy GeNN installation from builder stage
COPY --from=builder ${GENN_PATH} ${GENN_PATH}

# Copy Python packages from builder stage (Official python image uses site-packages, not dist-packages)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

COPY --from=builder /usr/local/bin /usr/local/bin

# Set PYTHONPATH to include GeNN
ENV PYTHONPATH=${GENN_PATH}:${PYTHONPATH}

# Copy application code
COPY . .

# Create directory for GeNN models
RUN mkdir -p /tmp/genn_models

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://127.0.0.1:8000/api/health')" || exit 1

# Expose API and WebSocket ports
EXPOSE 8000 9001 9002

# Increase stack size for C++ compilation and run the application
CMD ["sh", "-c", "ulimit -s unlimited && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1"]