FROM ubuntu:22.04 as builder

ARG GENN_VER=latest
LABEL maintainer="SNNverse Team"

# Non-interactive timezone configuration
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# Set environment variables
ENV GENN_PATH=/opt/genn
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install build dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get install -yq --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3.11 \
    python3.11-dev \
    python3-pip \
    swig \
    pkg-config \
    libffi-dev \
    curl \
    wget \
    ninja-build \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Set python3.11 as default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# Upgrade pip and install base Python dependencies
RUN python3.11 -m pip install --upgrade pip setuptools wheel && \
    python3.11 -m pip install numpy psutil pybind11 pkgconfig

# Clone and build GeNN
RUN mkdir -p ${GENN_PATH} && \
    git clone https://github.com/genn-team/genn.git ${GENN_PATH}

WORKDIR ${GENN_PATH}

# Build GeNN with CPU-only support (no CUDA) optimized for ARM
RUN python3 setup.py develop

# Stage 2: Runtime image
FROM ubuntu:22.04

# Non-interactive timezone configuration
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Berlin

# Set environment variables
ENV GENN_PATH=/opt/genn
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV APP_DIR=/app

WORKDIR ${APP_DIR}

# Install runtime dependencies
RUN apt-get update && \
    apt-get upgrade -y && \
    ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone && \
    apt-get install -yq --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3-pip \
    build-essential \
    cmake \
    git \
    libffi-dev \
    libssl3 \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Set python3.11 as default python
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

# Upgrade pip
RUN python -m pip install --upgrade pip setuptools wheel

# Copy GeNN installation and Python packages from builder stage
COPY --from=builder ${GENN_PATH} ${GENN_PATH}
COPY --from=builder /usr/local/lib/python3.11/dist-packages /usr/local/lib/python3.11/dist-packages

# Set PYTHONPATH to include GeNN
ENV PYTHONPATH=${GENN_PATH}:${PYTHONPATH}

# Copy application requirements and install Python dependencies (pygenn already included via COPY above)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create directory for GeNN models
RUN mkdir -p /tmp/genn_models

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/api/health')" || exit 1

# Expose API and WebSocket ports
EXPOSE 8000 9001 9002

# Increase stack size for C++ compilation and run the application
CMD ["sh", "-c", "ulimit -s unlimited && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1"]
