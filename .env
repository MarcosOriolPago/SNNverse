# SpikeVerse Environment Configuration
# Copy this to .env and customize for your deployment

# ============================================================================
# PostgreSQL Database Configuration
# ============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=SpikeVerse_user
DB_PASSWORD=SpikeVerse_password
DB_NAME=SpikeVerse_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ============================================================================
# MinIO / S3 Object Storage Configuration
# ============================================================================

# Storage backend type: 'minio' or 's3'
STORAGE_TYPE=minio

# MinIO Configuration (Default)
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=SpikeVerse-models
STORAGE_REGION=us-east-1
STORAGE_PATH_STYLE=true

# Temporary Archive Directory (for zipped models)
TEMP_ARCHIVE_DIR=/tmp/snn_archives

# ============================================================================
# GeNN Configuration
# ============================================================================
GENN_PATH=/home/marcos/marcos/snns/SpikeVerse/back/genn
GENN_BACKEND=auto

# ============================================================================
# Python/Application Settings
# ============================================================================
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
DEBUG=False

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# Performance Tuning
# ============================================================================
# Number of worker processes (Uvicorn)
WORKERS=4

# Maximum concurrent model builds
MAX_CONCURRENT_BUILDS=1

# Timeout for model compilation (seconds)
BUILD_TIMEOUT=300

# ============================================================================
# Feature Flags
# ============================================================================
# Enable database persistence
ENABLE_DB_PERSISTENCE=true

# Enable artifact storage (S3/MinIO)
ENABLE_ARTIFACT_STORAGE=true

# Enable warm-start escalation
ENABLE_WARM_START=true
